# AMI image for LocalStack EC2 Docker VM Manager.
# Tagged localstack-ec2/fmi-vm:ami-00000001 so that
# "aws ec2 run-instances --image-id ami-00000001" launches a real container.
#
# Based on the LocalStack EC2 Amazon Linux 2023 base image which already has
# openssh-server configured (required for the Docker VM Manager to SSH in and
# execute user-data scripts).  We add Python 3.11 and install the pre-built
# fmi.so bundle so "python3.11 /var/task/vm_worker.py" works inside the instance.

FROM localstack-ec2/amazonlinux-2023:ami-024f768332f0

# Install Python 3.11 (available in AL2023 repos)
RUN dnf install -y python3.11 && dnf clean all

# Copy the pre-built bundle (built for AL2 / Lambda, ABI-compatible with AL2023)
COPY build/bundle/fmi.so /var/task/fmi.so
COPY build/bundle/lib/ /var/task/lib/

# Copy worker Python sources and FMI config
COPY worker_core.py    /var/task/worker_core.py
COPY vm_worker.py      /var/task/vm_worker.py
COPY fmi-worker.json   /var/task/fmi-worker.json
