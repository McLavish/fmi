+    // raises SIGPIPE, whose default disposition would kill the whole single-threaded server and
+    // break every other in-flight pairing. Ignore it so send() fails with EPIPE instead and the
+    // loop keeps serving other clients.
+    signal(SIGPIPE, SIG_IGN);
